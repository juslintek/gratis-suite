ARG PHP_VERSION=8.6
FROM dunglas/frankenphp:php${PHP_VERSION}-alpine AS base
RUN apk add --no-cache curl tar unzip
RUN install-php-extensions gd zip intl exif bcmath mbstring pdo_sqlite sqlite3
RUN printf "%s\n" "opcache.enable=1" "opcache.memory_consumption=256" "opcache.max_accelerated_files=20000" "opcache.validate_timestamps=1" "opcache.revalidate_freq=0" "opcache.jit=1255" "opcache.jit_buffer_size=128M" > /usr/local/etc/php/conf.d/zz-opcache.ini
RUN printf "%s\n" "memory_limit=256M" "upload_max_filesize=64M" "post_max_size=64M" "display_errors=Off" "log_errors=On" "expose_php=Off" > /usr/local/etc/php/conf.d/zz-perf.ini
RUN curl -fsSL -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x /usr/local/bin/wp
RUN curl -fsSL https://wordpress.org/latest.tar.gz -o /tmp/wp.tgz && tar -xzf /tmp/wp.tgz -C /tmp && rm -f /tmp/wp.tgz
EXPOSE 80 443

# MariaDB + Redis performance stack (docker-compose.perf.yml)
# phpredis does not compile on PHP 8.6 yet; install it automatically on PHP <= 8.5.
FROM base AS perf
RUN install-php-extensions mysqli pdo_mysql \
    && if php -r 'exit(PHP_VERSION_ID < 80600 ? 0 : 1);'; then install-php-extensions redis; fi
RUN mkdir -p /app && cp -a /tmp/wordpress/. /app/ && rm -rf /tmp/wordpress
COPY Caddyfile /etc/frankenphp/Caddyfile
RUN sed -i 's|root \* /app/public|root * /app|' /etc/frankenphp/Caddyfile
WORKDIR /app

# Default: SQLite parity stack (matches production gratis.superglobalsdevelopment.com)
FROM base AS sqlite
RUN mkdir -p /app/public && cp -a /tmp/wordpress/. /app/public/ && rm -rf /tmp/wordpress
RUN curl -fsSL -o /tmp/sq.zip https://downloads.wordpress.org/plugin/sqlite-database-integration.latest-stable.zip \
    && unzip -q /tmp/sq.zip -d /app/public/wp-content/plugins/ \
    && sed -e "s#{SQLITE_IMPLEMENTATION_FOLDER_PATH}#/app/public/wp-content/plugins/sqlite-database-integration#g" \
           -e "s#{SQLITE_PLUGIN}#sqlite-database-integration/load.php#g" \
           /app/public/wp-content/plugins/sqlite-database-integration/db.copy > /app/public/wp-content/db.php \
    && rm -f /tmp/sq.zip
COPY wp-config.franken.php /app/public/wp-config.php
COPY Caddyfile /etc/frankenphp/Caddyfile
WORKDIR /app/public
